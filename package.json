{
  "name": "lembra",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter mobile dev",
    "web": "pnpm --filter mobile web",
    "android": "pnpm --filter mobile android",
    "ios": "pnpm --filter mobile ios",
    "build:web": "pnpm --filter mobile build:web",
    "serve:web": "pnpm --filter mobile build:web && node apps/mobile/scripts/serve-web.mjs",
    "test": "pnpm --filter mobile test",
    "lint": "pnpm --filter mobile lint"
  }
}
