# Apenas valores de desenvolvimento local. Nunca coloque segredos reais aqui.
LEMBRA_ENV=local
LEMBRA_HTTP_ADDR=:8080
LEMBRA_LOG_LEVEL=info
LEMBRA_DATABASE_URL=postgres://lembra:lembra@localhost:5433/lembra?sslmode=disable
LEMBRA_S3_ENDPOINT=http://localhost:9000
LEMBRA_S3_ACCESS_KEY=lembra
LEMBRA_S3_SECRET_KEY=lembra-secret
LEMBRA_S3_BUCKET=lembra
