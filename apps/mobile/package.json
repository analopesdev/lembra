{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "i18next": "^27.2.3",
    "lucide-react-native": "^1.77.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "ts-fsrs": "6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "lint-staged": "^17.6.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "gen:api": "openapi-typescript ../../contracts/openapi.yaml -o src/data/api/schema.gen.ts",
    "gen:api:check": "pnpm gen:api && git diff --exit-code -- src/data/api/schema.gen.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "lint-arch-test": "bash scripts/lint-arch-test.sh",
    "test": "jest",
    "format": "prettier --write .",
    "gen:vectors": "node scripts/gen-fsrs-vectors.mjs",
    "gen:vectors:check": "pnpm gen:vectors && git diff --exit-code -- ../../contracts/fsrs-vectors",
    "e2e:web": "playwright test -c e2e/playwright/playwright.config.ts",
    "build:web": "expo export --platform web",
    "db:generate": "drizzle-kit generate && node scripts/gen-migrations.mjs",
    "db:check": "bash scripts/check-migrations.sh",
    "gen:study-day": "node scripts/gen-study-day-vectors.mjs",
    "gen:study-day:check": "pnpm gen:study-day && git diff --exit-code -- ../../contracts/study-day-vectors"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^lucide-react-native$": "<rootDir>/../../node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!**/*.gen.ts",
      "!**/__tests__/**"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/dist/",
      "/test-results/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|react-native-svg|lucide-react-native))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}
