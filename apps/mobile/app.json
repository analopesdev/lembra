{
  "expo": {
    "name": "Lembra",
    "slug": "lembra",
    "scheme": "lembra",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icone/app-icon-1024.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icone/android-adaptive-foreground-1024.png",
        "backgroundColor": "#293746"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icone/favicon-32.png"
    }
  }
}
